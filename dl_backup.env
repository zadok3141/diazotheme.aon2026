# dl_backup.sh configuration — diazotheme.aon2026 (AON intranet theme)
#
# Every value that differs between OAG/AO repos lives here; dl_backup.sh
# itself is identical everywhere. Command-line flags still win over these.
# Check compatibility with:  ./dl_backup.sh --version

DL_BACKUP_ENV_VERSION=2

# Where backups are fetched from. Required — the script refuses to run
# without it rather than guess and restore the wrong site.
DL_BACKUP_BUCKET="s3://oag-backups/from_wpintranet03.oag.net/"

# Where the database is installed to, relative to the repo root.
DL_BACKUP_FILESTORAGE_DIR="instance/var/filestorage"
DL_BACKUP_BLOBSTORAGE_DIR="instance/var/blobs"

# The directory the blobstorage tarball unpacks to. This is not a free
# choice — it must match what this site's tarball actually contains.
DL_BACKUP_EXTRACT_DIR="latest"

# Prefix for the snapshot directories taken before an install.
DL_BACKUP_CURRENT_PREFIX="current-backup-"
